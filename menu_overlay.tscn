[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/dungeon/menu_overlay.gd" id="1_menu"]

[node name="MenuOverlay" type="CanvasLayer"]
script = ExtResource("1_menu")

[node name="Control" type="Control" parent="."]
mouse_filter = 0
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Dim" type="ColorRect" parent="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0, 0.6)

[node name="Center" type="CenterContainer" parent="Control"]
anchor_right = 1.0
anchor_bottom = 1.0

[node name="VBox" type="VBoxContainer" parent="Control/Center"]
theme_override_constants/separation = 6
alignment = 1

[node name="Title" type="Label" parent="Control/Center/VBox"]
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 28
horizontal_alignment = 1
vertical_alignment = 1
text = "GAME OVER"

[node name="PrimaryButton" type="Button" parent="Control/Center/VBox"]
custom_minimum_size = Vector2(90, 18)
theme_override_font_sizes/font_size = 11
text = "Try Again"

[node name="SecondaryButton" type="Button" parent="Control/Center/VBox"]
custom_minimum_size = Vector2(90, 18)
theme_override_font_sizes/font_size = 11
text = "Quit"
